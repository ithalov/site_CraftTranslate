  "proposal_rules": [
    {
      "id": "english-source-only",
      "title": "English source only",
      "description": "New strings must always be written in English first.",
      "required": true
    },
    {
      "id": "context-required",
      "title": "Context required",
      "description": "Every proposal must include theme, category, subcategory, and context.",
      "required": true
    },
    {
      "id": "placeholder-preservation",
      "title": "Preserve placeholders",
      "description": "Variables such as {player}, {amount}, {item}, %s, and %d must be preserved exactly.",
      "required": true
    },
    {
      "id": "protected-terms",
      "title": "Protected terms",
      "description": "Terms like XP, TPS, Minecraft, Discord, and ChatTranslate cannot be altered when marked protected.",
      "required": true
    },
    {
      "id": "target-language",
      "title": "Target language",
      "description": "The target language must match a supported language in the project.",
      "required": true
    }
  ]
